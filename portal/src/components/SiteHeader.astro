---
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={base} aria-label="Vagrant Hub — início"><span class="brand-mark"><Icon name="box" size={22} /></span><span>vagrant<span class="brand-light">hub</span><span class="brand-period">.</span></span></a>
    <nav class="desktop-nav" aria-label="Navegação principal"><a href={`${base}#how-it-works`}>Como usar</a><a href={`${base}#about`}>Mantenedor</a></nav>
    <a class="header-action" href={`${base}boxes/`}>Explorar boxes <Icon name="arrow" size={16} /></a>
    <button class="mobile-menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" data-menu-toggle><Icon name="menu" size={22} /></button>
  </div>
  <nav class="mobile-nav" aria-label="Navegação móvel" data-mobile-nav hidden><a href={`${base}boxes/`}>Explorar boxes</a><a href={`${base}#how-it-works`}>Como usar</a><a href={`${base}#about`}>Mantenedor</a></nav>
</header>
