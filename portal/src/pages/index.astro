---
import SiteLayout from '../components/SiteLayout.astro';
import BoxCard from '../components/BoxCard.astro';
import Icon from '../components/Icon.astro';
import catalog from '../data/catalog.json';

const boxes = catalog.boxes;
const featured = boxes.filter((box) => box.featured);
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Vagrant Hub — catálogo de boxes Vagrant" description="Compare versões, providers e checksums de boxes Vagrant para ambientes locais e laboratórios.">
  <section class="hero-shell">
    <div class="hero-grid"></div>
    <div class="hero-orb hero-orb-one"></div>
    <div class="hero-orb hero-orb-two"></div>
    <div class="container hero-content">
      <div class="eyebrow"><span class="eyebrow-dot"></span> VAGRANT BOXES</div>
      <h1>Boxes para o seu<br /><span>ambiente de desenvolvimento.</span></h1>
      <p class="hero-description">Encontre uma imagem, confira o provider e use no seu Vagrantfile.</p>
      <form class="hero-search" action={`${base}boxes/`} method="get">
        <Icon name="search" size={21} />
        <input name="q" type="search" aria-label="Buscar boxes" placeholder="Sistema, versão ou provider" data-box-search />
        <button type="submit">Buscar <Icon name="arrow" size={16} /></button>
      </form>
      <div class="hero-meta">
        <span><Icon name="layers" size={16} /> {boxes.length} {boxes.length === 1 ? 'box publicada' : 'boxes publicadas'}</span>
        <span><Icon name="shield" size={16} /> SHA-256 por release</span>
      </div>
    </div>
  </section>

  <section class="section catalog-section" id="catalog">
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="section-kicker">CATÁLOGO</div>
          <h2>Boxes disponíveis<span class="blue-period">.</span></h2>
        </div>
        <a class="text-link" href={`${base}boxes/`}>Ver catálogo <Icon name="arrow" size={17} /></a>
      </div>
      <div class="box-grid" data-home-grid>
        {featured.map((box) => <div data-home-card><BoxCard box={box} /></div>)}
      </div>
      <div class="empty-state" data-empty-results hidden><span>Nenhuma box corresponde à busca.</span><a href={`${base}boxes/`}>Abrir o catálogo</a></div>
    </div>
  </section>

  <section class="section steps-section" id="how-it-works">
    <div class="container">
      <div class="section-heading"><div><div class="section-kicker">COMO USAR</div><h2>Pronta para o Vagrant<span class="blue-period">.</span></h2></div></div>
      <div class="steps-grid">
        <article class="step-card"><span class="step-number">01</span><span class="step-icon"><Icon name="search" size={22} /></span><h3>Escolha a box</h3><p>Encontre o sistema e a versão.</p></article>
        <article class="step-card"><span class="step-number">02</span><span class="step-icon"><Icon name="shield" size={22} /></span><h3>Confira o provider</h3><p>Veja os detalhes e o checksum.</p></article>
        <article class="step-card"><span class="step-number">03</span><span class="step-icon"><Icon name="terminal" size={22} /></span><h3>Use no Vagrant</h3><p>Copie a configuração da release.</p></article>
      </div>
    </div>
  </section>
</SiteLayout>
